# Deny direct HTTP access to data and credentials in this directory.
#
# searches.json records what visitors type; config.php holds the AliExpress
# app secret. Neither is meant to be fetchable. PHP files are executed rather
# than served, so config.php is already safe, but the rule is explicit because
# a server misconfiguration that stops executing PHP would otherwise publish
# the secret as plain text.
#
# The previous contents of this file opened with <?php - Apache reads .htaccess
# literally, so those lines were invalid directives and the rewrite rules below
# them never applied.
<FilesMatch "\.(json|log|bak)$">
    Require all denied
</FilesMatch>
<Files "config.php">
    Require all denied
</Files>
<Files "blocklist.php">
    Require all denied
</Files>
