.env.ftp

# any variant, so a stray .bak can never be committed
.env.ftp*

# Credential notes kept in the working tree. PW.txt sat here untracked and
# un-ignored on 2026-08-17, meaning the next `git add -A` would have committed
# it to a repo that is pushed to GitHub. Ignore the file and its obvious
# variants rather than relying on nobody running that command.
PW.txt
PW*.txt
*password*.txt
*credentials*.txt
*creds*.txt

# Live-search credentials. Holds the AliExpress app secret; this repo is public
# and deploy.sh walks the whole tree, so committing it would put the secret in
# git history AND on a public host. See api/config.example.php.
api/config.php

# Runtime data written by the PHP endpoints on the live host — what visitors
# searched for, who subscribed, and the view/click counters. The host owns these
# files; this repo must never carry a copy. A committed copy would both publish
# subscriber addresses to a public repo and, via deploy.sh, overwrite the live
# file with a stale one. deploy.sh excludes the same pattern.
api/*.json
