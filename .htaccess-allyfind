# allyfind.com — click-tracking hop only.
#
# This is deliberately NOT a copy of fashionhotspot.site's .htaccess: this
# site has never had one, and copying that file's other rules (brand-specific
# 2026-suffix redirects, etc.) onto a host that has never run them is an
# untested change with a much bigger blast radius than the one rule this
# task actually needs. Add rules here later if allyfind.com needs its own
# equivalents; do not paste the other file's rules in wholesale.
#
# /go/<id>?u=<url> -> /api/go.php?id=<id>&u=<url> (query string preserved by
# QSA, so u travels through untouched). See api/go.php for what happens next.
# 25.10.2026: our own 404 page (allyfind-404.html, uploaded as /404.html). The host default error page loads the host's
# Google Analytics tag, i.e. tracking before any consent for every visitor who hits a missing URL.
ErrorDocument 404 /404.html
<IfModule mod_rewrite.c>
    RewriteEngine On
    # FIX-2 (4 Oct 2026 audit A-4): one canonical host. www.allyfind.com answered 200 with the same pages as allyfind.com;
    # now a permanent redirect (path and query string are kept).
    RewriteCond %{HTTP_HOST} ^www\.allyfind\.com$ [NC]
    RewriteRule ^(.*)$ https://allyfind.com/$1 [R=301,L]
    RewriteRule ^go/([A-Za-z0-9._-]+)$ /api/go.php?id=$1 [QSA,L]
    # bare /go and /go/ (no id) reach go.php too, which answers 400 like every other bad request
    RewriteRule ^go/?$ /api/go.php [QSA,L]

    # Audit 13.10: Hebrew is the default for Israeli visitors. "/" answers 302 -> /he/ when the browser lists Hebrew FIRST
    # in Accept-Language (he, he-IL, legacy iw) - unless the visitor chose a language: ?lang= on the URL, or the fhs_lang
    # cookie the site's language picker writes (and /en/ writes "en"). A chosen "he" goes to /he/ too. /he/ and /en/
    # themselves are never redirected, so there is no loop. Canonical + hreflang live in the pages and do not change:
    # English "/", Hebrew "/he/", x-default "/".
    RewriteCond %{QUERY_STRING} !(^|&)lang= [NC]
    RewriteCond %{HTTP_COOKIE} !(^|;\s*)fhs_lang=
    RewriteCond %{HTTP:Accept-Language} ^\s*(he|iw)(-|;|,|\s|$) [NC]
    RewriteRule ^$ /he/ [R=302,L]
    RewriteCond %{QUERY_STRING} !(^|&)lang= [NC]
    RewriteCond %{HTTP_COOKIE} (^|;\s*)fhs_lang=he(;|$)
    RewriteRule ^$ /he/ [R=302,L]
    # /en/ (and /en) = the English homepage for everyone, whatever the browser prefers. Same file as "/", whose URLs are
    # all absolute (build-static.js englishAtAnyDepth), and the page's script keeps it English there.
    RewriteRule ^en/?$ /index.html [L]
</IfModule>

# "/" now depends on Accept-Language and the fhs_lang cookie: say so, so no cache hands one visitor's answer to another.
<IfModule mod_setenvif.c>
    SetEnvIf Request_URI "^/$" AF_LANG_ROOT
</IfModule>
<IfModule mod_headers.c>
    Header always merge Vary "Accept-Language" env=AF_LANG_ROOT
    Header always merge Vary "Cookie" env=AF_LANG_ROOT
</IfModule>

# H2 security headers (fix queue, 2026-09-28)
<IfModule mod_headers.c>
    Header always set Strict-Transport-Security "max-age=31536000"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    # FIX-2 (4 Oct 2026 audit A-5)
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    # REPORT-ONLY: blocks nothing. Move to an enforcing Content-Security-Policy only after a week with no violations.
    Header always set Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https:; connect-src 'self' https:; frame-ancestors 'self'; base-uri 'self'; form-action 'self'"
    Header unset X-Powered-By
</IfModule>
